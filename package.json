{
  "name": "pokereader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Scan a Pokémon card and get a simple explanation a six year old can understand.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist/server/index.js",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test src/server/scan.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
