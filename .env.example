# Required. Get one at https://platform.deepseek.com/api_keys
# Server side only. Never put this in client code or a VITE_ variable.
DEEPSEEK_API_KEY=

# Optional settings (defaults shown)
# PORT=3000
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_THINKING=disabled        # "enabled" is slower and costs more, may read hard cards better
# DEEPSEEK_TIMEOUT_MS=45000
# MAX_UPLOAD_MB=8
# RATE_LIMIT_MAX=30                 # scans allowed per window, per IP address
# RATE_LIMIT_WINDOW_MINUTES=10
# TRUST_PROXY=1                     # set when running behind Caddy/nginx so rate limiting sees real IPs
# ORIGIN_SECRET=                    # if set, requests must send it in the x-origin-secret header

# Lambda deploy only: becomes ORIGIN_SECRET on the function, so only your proxy can call it.
# LAMBDA_ORIGIN_SECRET=

# Read-aloud voices from Amazon Polly (men, women and kids). On automatically on AWS Lambda.
# Elsewhere set this to true; the server then needs AWS credentials allowed to call polly:SynthesizeSpeech.
# POLLY_VOICES=true
